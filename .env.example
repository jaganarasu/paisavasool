# Postgres connection strings from Neon (or Vercel Postgres, which is Neon under the hood).
# Neon gives you two: a pooled one (for the app) and a direct one (for migrations).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/paisavasool?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/paisavasool?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used once by `npm run seed` to create your first admin login.
# Change the password and re-run seed, or just change it from the DB after first login.
SEED_ADMIN_EMAIL="admin@paisavasool.in"
SEED_ADMIN_PASSWORD="ChangeMe123!"
